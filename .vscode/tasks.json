{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "assets: copy",
      "type": "shell",
      "command": "mkdir -p dist/images dist/fonts dist/music && cp -R include/images/. dist/images/ && cp -R include/fonts/. dist/fonts/ && cp -R include/music/. dist/music/",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "tweego: build",
      "dependsOn": ["assets: copy"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "tweego",
      "args": ["-f", "sugarcube-2", "-o", "dist/story.html", "src"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TWEEGO_PATH": ".storyformats"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "tweego: watch",
      "dependsOn": ["assets: copy"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "tweego",
      "args": ["-w", "-f", "sugarcube-2", "-o", "dist/story.html", "src"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TWEEGO_PATH": ".storyformats"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "run: build + open",
      "dependsOn": ["tweego: build"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "open",
      "args": ["dist/story.html"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
