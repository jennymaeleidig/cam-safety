# macOS
.DS_Store

# Build output (regenerable via the "tweego: build" task in
# .vscode/tasks.json)
dist/

# Generated ctags index
/tags

# Agent tooling cache
.pi/

# Local issue-tracker scratch (kept out of the repo)
.scratch/

# The global gitignore excludes .vscode/; this project's Tweego build
# task lives there and is tracked
!.vscode/
.vscode/*
!.vscode/tasks.json
# Node toolchain: language servers for the editor, plus Prettier, Husky and
# lint-staged behind `npm install` — not build input
node_modules/