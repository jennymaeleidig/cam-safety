:: StoryTitle {"position":"0,700"}
Cam Safety

:: StoryInit
/* Content macros: each records one stage slot's content (src/js/stage.js,
   which writes the slots once per passage) and renders nothing into
   #passages, so the stage owns all visible content for [checker] passages.
   Authoring is documented in docs/authoring.md; story.twee-config.yaml carries
   the descriptions the editor shows. */
<<script>>
(function () {
	/* The published layout is the one the macros check: layout.js has already
	   written it when the passage renders, and this passage's own
	   <<set_layout>> has run by the time a line macro below it does. */
	function layout() {
		return Layout.current();
	}

	Macro.add("set_layout", {
		handler : function () {
			if (this.args.length === 0) {
				return this.error("missing layout number (0-4)");
			}
			Layout.set(this.args[0]);
		}
	});

	Macro.add("cam_line", {
		handler : function () {
			if (layout() === 4) {
				return this.error("the System layout has no speech bubble; use <<system_line>>");
			}
			Stage.setCamLine(this.args[0]);
		}
	});

	Macro.add("player_line", {
		handler : function () {
			Stage.setPlayerLine(this.args[0]);
		}
	});

	Macro.add("system_line", {
		handler : function () {
			if (layout() !== 4) {
				return this.error("a system message needs the System layout (<<set_layout 4>>); this passage is Layout " + layout());
			}
			Stage.setSystemLine(this.args[0]);
		}
	});

	Macro.add("portrait", {
		handler : function () {
			if (layout() === 4) {
				return this.error("the System layout composes no portrait");
			}
			Stage.setPortrait(this.args[0], this.args[1]);
		}
	});
})();
<</script>>

:: Layouts [scratch] {"position":"0,750"}
/* Entry point for the layout scratch passages — open it from the browser
   console:
     SugarCube.Engine.play("Layouts")
   Each link only navigates: the target passage's own <<set_layout>> applies
   while that passage renders, before it is displayed, so the first visible
   frame is already the layout it names. */
[[Layout 0->Layout 0]] · [[Layout 1->Layout 1]] · [[Layout 2->Layout 2]] · [[Layout 3->Layout 3]] · [[Layout 4->Layout 4]]

