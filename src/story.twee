:: StoryTitle {"position":"0,700"}
Cam Safety

:: StoryInit
/* macros */
<<script>>
Macro.add("raise_pressure", {
	handler : function () {
		const amt = Number(this.args[0] ?? 1);
		State.variables.pressure = (State.variables.pressure ?? 0) + amt;
		jQuery(this.output).wiki(`Pressure is now ${State.variables.pressure}.`);
	}
});
<</script>>

